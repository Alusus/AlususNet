@merge module AlususNet {
    class Client {
        def GET_PLANS: "/api/plans";
        def CREATE_API_TOKEN_PATH: "/api/token";
        def GET_PROJECT_STATUS_PATH: "/api/project/setup-status";
        def SETUP_PROJECT_PATH: "/api/project/setup";
        def UPLOAD_PROJECT_PATH: "/api/project/upload";
        def UPLOAD_BACKUP_PATH: "/api/project/backup/upload";
        def CREATE_BACKUP_PATH: "/api/project/backup";
        def CHANGE_PLAN_PATH: "/api/project/change-plan";
        def CREATE_AUTH_TOKEN_MFA: "/api/user/verify-mfa";
        def CREATE_AUTH_TOKEN: "/api/login";
        def CHECK_BACKUP_STATUS: "/api/project/backup/status";
        def BATCH_SIZE: 102400;
        def DEFAULT_HOST: "https://alusus.net";
        def HOST_ENV_NAME: "ALUSUS_NET_HOST";
        def DEFAULT_CONFIG_PATH: ".config/alususnet.conf";
        def CONFIG_PATH_ENV_NAME: "ALUSUS_NET_CONFIG_PATH";

        @shared def host: String(CharsPtr().{
            this = System.getEnv(HOST_ENV_NAME);
            if this == 0 this = DEFAULT_HOST;
        });

        def projectName: String;
        def confFilePath: String;
        def plans: Json;

        def userName: String;
        def password: String;
        def authKey: String;
        def trustKey: String;
        def apiKey: String;

        def termOfUseAccepted: Bool = false;
        def invalidCodeCounter: Int = 3;
        def verbose: bool = true;
        def desiredPlanName: String;

        handler this~init(projName: String, apiKey: String, verbose: bool) {
            this.projectName = projName;
            this.verbose = verbose;
            this.apiKey = apiKey;
            // If apiKey is provided, skip the config file and just depend on the provided key.
            if this.apiKey == "" {
                def confFilePath: CharsPtr = System.getEnv(CONFIG_PATH_ENV_NAME);
                if confFilePath == 0 {
                    this.confFilePath = String.format("%s/%s", System.getEnv("HOME"), DEFAULT_CONFIG_PATH);
                } else {
                    this.confFilePath = confFilePath;
                }
            }
        }

        handler this_type(projName: String): SrdRef[Client] {
            return SrdRef[Client]().{ alloc()~init(projName, String(), false) };
        }

        handler this_type(projName: String, myApiKey: String): SrdRef[Client] {
            return SrdRef[Client]().{ alloc()~init(projName, myApiKey, false) };
        }

        handler this_type(projName: String, apiKey: String, verbose: bool): SrdRef[Client] {
            return SrdRef[Client]().{ alloc()~init(projName, apiKey, verbose) };
        }

        handler this.acceptTermOFUse() {
            if getUserYesNoAnswer(i18nOut(
                "Before proceeding, please read and agree to the following:\n\n"
                "Terms of Service: https://alusus.net/terms-of-service\n"
                "Privacy Policy: https://alusus.net/privacy-policy\n"
                "By using Alusus Net, you agree to the above terms of service and privacy policy.\n\n"
                "Do you accept these terms? [Y/n] "
            )) == "yes" {
                this.termOfUseAccepted = true;
            } else {
                this.termOfUseAccepted = false;
                System.exit(1);
            }
        }

        handler this.setDesiredPlan(planName: String) {
            this.desiredPlanName = planName;
        }

        handler this.publish(serverPort: int) {
            this.publish(serverPort, String(), String());
        }

        handler this.publish(serverPort: Int, projectPath: String, starter: String) {
            if checkProjectName(this.projectName) {
                this.fetchPlans();
                this.fetchApiToken();
                this.setupProject();
                this.uploadProject(serverPort, projectPath, starter);
            } else {
                Console.print(i18nOut(
                    "Invalid project name. It should only contain lowercase letters, numbers, "
                    "hyphens (-), and must not start or end with a hyphen.\n"
                ));
            }
        }

        handler this.restoreDbBackup(restore_db_path: String) {
            this.fetchApiToken();
            this.uploadBackup(restore_db_path);
        }

        handler this.downloadDbBackup(backup_db_path: String) {
            this.fetchApiToken();
            this.downloadBackup(backup_db_path);
        }

        handler this.listPlans() {
            this.fetchPlans();
            Console.print(i18nOut("Available hosting plans:\n"));
            def i: Int;
            for i = 0, i < this.plans.getLength(), ++i {
                Console.print("\n");
                Console.print(getPlanInfoString(this.plans(i)));
            }
        }

        handler this.changePlan(planName: String) {
            this.changePlan(planName, String());
        }

        handler this.changePlan(planName: String, promotionCode: String) {
            this.fetchApiToken();
            this.fetchPlans();
            def plan: Json = this.findPlanByName(planName);
            if plan.getLength() == 0 {
                System.fail(1, i18nOut("No hosting plan found with the given name.\n"));
            }
            this.changePlanById(plan("id"), promotionCode);
            Console.print(i18nOut("Hosting plan changed successfully.\n"));
        }

        handler this.changePlanById(planId: String, promotionCode: String) {
            while 1 {
                def request: Net.Request(host + CHANGE_PLAN_PATH);
                request.verbose = this.verbose;
                request.authType = "Bearer";
                request.authKey = this.apiKey;
                request.contentType = "application/json";
                request.post(String.format(
                    "{\"projectName\": \"%s\", \"planId\": \"%s\", \"promotionCode\": \"%s\"}",
                    Json.escape(this.projectName).buf,
                    Json.escape(planId).buf,
                    Json.escape(promotionCode).buf
                ));
                if request.responseHttpStatus == 200 {
                    break;
                } else if request.responseHttpStatus == 402 {
                    Console.print(
                        i18nOut(
                            "Please setup your payment profile by visiting this URL:\n"
                            "%s\nPress enter when you're done.\n"
                        ),
                        request.responseBody.buf
                    );
                    Console.getChar();
                } else if request.responseHttpStatus == 400 and request.responseBody == "promotion_code" {
                    def answer: String = getUserMultipleOptionsAnswer(
                        i18nOut(
                            "Provided promotion code is invalid. Re-enter prmotion code? "
                            "(Type `yes` to enter a new code or `cancel` to quit) "
                        ),
                        Map[String, String]()
                            .set(String("yes"), String("yes"))
                            .set(String("y"), String("yes"))
                            .set(String("cancel"), String("cancel"))
                            .set(String("c"), String("cancel"))
                    );
                    if answer == "yes" {
                        promotionCode = getUserTextAnswer(i18nOut(
                            "Enter promotion code or leave empty to proceed without a promotion code: "
                        ), true);
                    } else if answer == "cancel" {
                        System.exit(1);
                    }
                } else if request.responseHttpStatus == 404 {
                    System.fail(1, i18nOut("Project not found\n"));
                } else if request.responseHttpStatus == 401 {
                    handle401Error[];
                } else if request.responseHttpStatus == 423 {
                    Console.print(i18nOut(
                        "Some operation is currently in progress on this project's container. Retry (yes/no)? "
                    ));
                    if getUserYesNoAnswer(String()) != "yes" {
                        System.exit(1);
                    }
                } else {
                    handleUnexpectedCommunicationError[];
                }
            }
        }

        macro handle401Error {
            // If we don't have a confFilePath it means an API key was passed to us, which means
            // we just fail if the key is invalid rather than request a new key from the user. This
            // is to handle the case of running in CI and passing an API key.
            if this.confFilePath != "" {
                Console.print(i18nOut("\nExisting auth key is no longer valid. Requesting a new auth key.\n"));
                this.apiKey.clear();
                this.saveConf();
                this.fetchApiToken();
            } else {
                System.fail(1, i18nOut("\nProvided API key is not valid.\n"));
            }
        }

        handler this.fetchPlans() {
            while 1 {
                def request: Net.Request(String.format("%s%s", host.buf, GET_PLANS));
                request.verbose = this.verbose;
                request.get();
                if request.responseHttpStatus == 200 {
                    this.plans = request.responseBody;
                    if this.plans.getLength() < 1 {
                        System.fail(1, i18nOut("Failed to fetch plan info from AlususNet\n"));
                    }
                    break;
                } else {
                    handleUnexpectedCommunicationError[];
                }
            }
        }

        handler this.findPlan(planId: String): Json {
            def i: Int;
            for i = 0, i < this.plans.getLength(), ++i {
                def plan: Json = this.plans(i);
                if plan("id")~cast[String] == planId return plan;
            }
            return Json();
        }

        handler this.findPlanByName(planName: String): Json {
            def i: Int;
            for i = 0, i < this.plans.getLength(), ++i {
                def plan: Json = this.plans(i);
                if plan("name")~cast[String] == planName
                or getLocalizedText(plan("nameLocalizations"), plan("name")) == planName {
                    return plan;
                }
            }
            return Json();
        }

        handler this.readConf() {
            // Skip if no conf file is set, because it means an API key was provided and we'll
            // just use that without dealing with the conf file.
            if this.confFilePath == "" return;
            if Fs.exists(this.confFilePath) {
                def data: String = Fs.readFile(this.confFilePath);
                def json: Json(data);
                this.userName = json("userName");
                this.trustKey = json("trustKey");
                this.apiKey = json("apiKey");
            } else {
                this.userName.clear();
                this.trustKey.clear();
                this.apiKey.clear();
            }
        }

        handler this.saveConf() {
            def data: StringBuilder[JsonStringBuilderMixin](1024, 1024);
            data.format(
                "{\n \"userName\": %js,\n \"trustKey\": %js,\n \"apiKey\": %js\n}",
                this.userName, this.trustKey, this.apiKey
            );
            Fs.createFile(this.confFilePath, data, data.getLength());
        }

        handler this.fetchAuthToken() {
            def userName: array[Char, 256];
            def password: String;
            def mfaCode: array[Char, 100];
            macro promptForUserName{
                Console.print(i18nOut("Enter username: \n>"));
                Console.getString(userName~ptr, 256);
            }
            macro promptForPassword{
                Console.print(i18nOut("Enter password: \n>"));
                password = Console.getStealthString();
            }
            macro promptForMfaCode{
                Console.print(i18nOut("Enter MFA code or enter 'back' to login again: \n>"));
                Console.getString(mfaCode~ptr, 100);
            }
            promptForUserName[];
            promptForPassword[];
            while 1 {
                def requestString: String;
                if this.trustKey != "" and this.userName == userName~ptr {
                    requestString = String.format(
                        "{\"username\": \"%s\" , \"password\": \"%s\" ,\"trustToken\": \"%s\"}",
                        Json.escape(String(userName~ptr).trim()).buf,
                        Json.escape(password.trim()).buf,
                        Json.escape(this.trustKey.trim()).buf
                    );
                } else {
                    requestString = String.format(
                        "{\"username\": \"%s\", \"password\": \"%s\"}",
                        Json.escape(String(userName~ptr).trim()).buf,
                        Json.escape(password.trim()).buf,
                    );
                }
                def request: Net.Request(host + CREATE_AUTH_TOKEN);
                request.verbose = this.verbose;
                request.post(requestString);
                if request.responseHttpStatus == 200 {
                    this.authKey = Json(request.responseBody)("authToken");
                    this.password = password;
                    break;
                } else if request.responseHttpStatus == 202 {
                    this.password = password;
                    promptForMfaCode[];
                    while 1 {
                        if i18nIn(mfaCode~ptr) == "back" break;
                        def verifyMfaCodeRequest: Net.Request(host + CREATE_AUTH_TOKEN_MFA);
                        verifyMfaCodeRequest.verbose = this.verbose;
                        verifyMfaCodeRequest.post(String.format(
                            "{\"username\": \"%s\" , \"password\": \"%s\" , \"code\": \"%s\"}",
                            Json.escape(String(userName~ptr).trim()).buf,
                            Json.escape(password.trim()).buf,
                            Json.escape(String(mfaCode~ptr).trim()).buf
                        ));
                        def status: int = verifyMfaCodeRequest.responseHttpStatus;
                        if status == 200 {
                            this.trustKey = Json(verifyMfaCodeRequest.responseBody)("trustToken");
                            this.userName = String(userName~ptr).trim();
                            this.authKey = Json(verifyMfaCodeRequest.responseBody)("authToken");
                            break 2;
                        } else {
                            if status == 401 {
                                Console.print(i18nOut("Code is invalid!\n"));
                                if this.invalidCodeCounter > 0 {
                                    this.invalidCodeCounter--;
                                    promptForMfaCode[];
                                } else {
                                    break;
                                }
                            } else {
                                handleUnexpectedCommunicationError[];
                            }
                        }
                    }
                    promptForUserName[];
                    promptForPassword[];
                } else if request.responseHttpStatus == 401 {
                    Console.print(i18nOut("Authentication error. Invalid username or password.\n"));
                    promptForUserName[];
                    promptForPassword[];
                } else if request.responseHttpStatus == 429 {
                    Console.print(i18nOut(
                        "The account is locked due to multiple incorrect password attempts. Please try again later.\n"
                    ));
                    System.exit(1);
                } else {
                    handleUnexpectedCommunicationError[];
                }
            }
            this.saveConf();
        }

        handler this.fetchApiToken() {
            this.readConf();
            if this.apiKey.trim() == "" {
                this.fetchAuthToken();
                while 1 {
                    def request: Net.Request(host + CREATE_API_TOKEN_PATH);
                    request.verbose = this.verbose;
                    request.authType = "Bearer";
                    request.authKey = this.authKey;
                    request.post(String.format(
                        "{\"name\": \"%s\" , \"password\" : \"%s\"}",
                        Json.escape(this.projectName).buf,
                        Json.escape(this.password).buf
                    ));
                    if request.responseHttpStatus == 201 {
                        this.apiKey = Json(request.responseBody)("token")~cast[String].trim();
                        this.saveConf();
                        break;
                    } else if request.responseHttpStatus == 401 {
                        Console.print(i18nOut("Authentication error.\n"));
                        this.userName.clear();
                        this.trustKey.clear();
                        this.apiKey.clear();
                        this.saveConf();
                        this.fetchAuthToken();
                    } else {
                        handleUnexpectedCommunicationError[];
                    }
                }
            }
        }

        handler this.setupProject() {
            def desiredPlan: Json;
            if this.desiredPlanName != "" {
                desiredPlan = this.findPlanByName(this.desiredPlanName);
                if desiredPlan.getLength() == 0 {
                    System.fail(1, i18nOut("No hosting plan found with the given name.\n"));
                }
            }
            def status: String;
            def planId: String;
            while 1 {
                def request: Net.Request(String.format(
                    "%s%s?project=%s", host.buf, GET_PROJECT_STATUS_PATH, Net.uriEncode(this.projectName).buf
                ));
                request.verbose = this.verbose;
                request.authType = "Bearer";
                request.authKey = this.apiKey;
                request.get();
                if request.responseHttpStatus == 200 {
                    request.responseBody.split("&").{
                        status = this(0);
                        planId = this(1).split("=")(1);
                    };
                    break;
                } else if request.responseHttpStatus == 400 {
                    System.fail(1, i18nOut("Project name is not valid.\n"));
                } else if request.responseHttpStatus == 401 {
                    handle401Error[];
                } else {
                    handleUnexpectedCommunicationError[];
                }
            }
            if status == "active" {
                this.setupActiveProject(desiredPlan, planId);
            } else if status == "inactive" {
                this.setupInactiveProject(desiredPlan, planId);
            } else {
                this.setupNewProject(desiredPlan);
            }
        }

        handler this.setupNewProject(desiredPlan: Json) {
            def plan: Json;
            if this.desiredPlanName != "" {
                plan = desiredPlan;
            } else {
                plan = this.plans(0);
            }
            def planId: String = plan("id");
            Console.print(i18nOut(
                "No existing project found with the same name. "
                "A new project will be created and a payment plan will be setup for it.\n"
            ));
            Console.print("\n");
            Console.print(i18nOut("Hosting plan:\n"));
            Console.print(getPlanInfoString(plan));
            Console.print("\n");
            def options: Map[String, String]() = Map[String, String]()
                .set(String("yes"), String("yes"))
                .set(String("y"), String("yes"))
                .set(String("no"), String("no"))
                .set(String("n"), String("no"))
                .set(String("coupon"), String("coupon"))
                .set(String("c"), String("coupon"));
            def prompt: String;
            if this.desiredPlanName == "" and this.plans.getLength() > 1 {
                prompt = i18nOut(
                    "Continue? (Type `yes` to proceed, `no` to cancel, "
                    "`plan` to change the hosting plan, "
                    "or `coupon` to enter a promotion code) "
                );
                options
                    .set(String("plan"), String("plan"))
                    .set(String("p"), String("plan"))
            } else {
                prompt = i18nOut(
                    "Continue? (Type `yes` to proceed, `no` to cancel, "
                    "or `coupon` to enter a promotion code) "
                );
            }
            def promotionCode: String;
            while 1 {
                def answer: String = getUserMultipleOptionsAnswer(prompt, options);
                if answer == "yes" {
                    break;
                } else if answer == "no" {
                    System.exit(1);
                } else if answer == "plan" {
                    planId = this.selectPlan();
                } else if answer == "coupon" {
                    promotionCode = getUserTextAnswer(i18nOut("Enter promotion code: "), true);
                }
            }
            if this.termOfUseAccepted == false this.acceptTermOFUse();
            this.performProjectSetup(planId, promotionCode);
        }

        handler this.setupActiveProject(desiredPlan: Json, planId: String) {
            def plan: Json = this.findPlan(planId);
            Console.print(i18nOut(
                "Existing project with the same name exists. The project will be overwritten.\n"
            ));
            def promotionCode: String;
            if this.desiredPlanName != "" and desiredPlan("id")~cast[String] != planId {
                Console.print("\n");
                Console.print(i18nOut("Current hosting plan:\n"));
                Console.print(getPlanInfoString(plan));
                Console.print("\n");
                Console.print(i18nOut("Hosting plan will be switched to:\n"));
                Console.print(getPlanInfoString(desiredPlan));
                Console.print("\n");
                while 1 {
                    def answer: String = getUserMultipleOptionsAnswer(
                        i18nOut(
                            "Continue? (Type `yes` to proceed, `no` to cancel, "
                            "or `coupon` to enter a promotion code) "
                        ),
                        Map[String, String]()
                            .set(String("yes"), String("yes"))
                            .set(String("y"), String("yes"))
                            .set(String("no"), String("no"))
                            .set(String("n"), String("no"))
                            .set(String("coupon"), String("coupon"))
                            .set(String("c"), String("coupon"))
                    );
                    if answer == "yes" {
                        break;
                    } else if answer == "no" {
                        System.exit(1);
                    } else if answer == "coupon" {
                        promotionCode = getUserTextAnswer(i18nOut("Enter promotion code: "), true);
                    }
                }
                this.changePlanById(desiredPlan("id"), promotionCode);
            } else {
                Console.print(i18nOut(
                    "Continue (yes/no)? "
                ));
                if getUserYesNoAnswer(String()) != "yes" {
                    System.exit(1);
                }
            }
        }

        handler this.setupInactiveProject(desiredPlan: Json, planId: String) {
            def plan: Json = this.findPlan(planId);
            if this.desiredPlanName == "" and plan.getLength() == 0 {
                // TODO: Give the user the option to select a valid plan instead of just failing
                System.fail(1, i18nOut(
                    "Existing, but inactive, project with the same name exists. "
                    "This project is in an invalid state and cannot be re-activated. "
                    "Contact AlususNet's support to resolve the issue, or change your "
                    "project's name to create a new project on AlususNet.\n"
                ));
            }
            Console.print(i18nOut(
                "Existing, but inactive, project with the same name exists. "
                "The project will be re-activated and overwritten. "
                "A new payment plan will be setup.\n"
            ));
            Console.print("\n");
            Console.print(i18nOut("Current hosting plan:\n"));
            Console.print(getPlanInfoString(plan));
            Console.print("\n");
            if this.desiredPlanName != "" and desiredPlan("id")~cast[String] != planId {
                Console.print(i18nOut("Hosting plan will be switched to:\n"));
                Console.print(getPlanInfoString(desiredPlan));
                Console.print("\n");
            }
            def promotionCode: String;
            while 1 {
                def answer: String = getUserMultipleOptionsAnswer(
                    i18nOut(
                        "Continue? (Type `yes` to proceed, `no` to cancel, "
                        "or `coupon` to enter a promotion code) "
                    ),
                    Map[String, String]()
                        .set(String("yes"), String("yes"))
                        .set(String("y"), String("yes"))
                        .set(String("no"), String("no"))
                        .set(String("n"), String("no"))
                        .set(String("coupon"), String("coupon"))
                        .set(String("c"), String("coupon"))
                );
                if answer == "yes" {
                    break;
                } else if answer == "no" {
                    System.exit(1);
                } else if answer == "coupon" {
                    promotionCode = getUserTextAnswer(i18nOut("Enter promotion code: "), true);
                }
            }
            if this.termOfUseAccepted == false this.acceptTermOFUse();
            if this.desiredPlanName != "" and desiredPlan("id")~cast[String] != planId {
                this.changePlanById(desiredPlan("id"), promotionCode);
            } else {
                this.performProjectSetup(planId, promotionCode);
            }
        }

        handler this.performProjectSetup(planId: String, promotionCode: String) {
            while 1 {
                def request: Net.Request(String.format(
                    "%s%s?project=%s&plan=%s&promotion_code=%s",
                    host.buf, SETUP_PROJECT_PATH,
                    Net.uriEncode(this.projectName).buf,
                    Net.uriEncode(planId).buf,
                    Net.uriEncode(promotionCode).buf
                ));
                request.verbose = this.verbose;
                request.authType = "Bearer";
                request.authKey = this.apiKey;
                request.post("");
                if request.responseHttpStatus == 200 {
                    break;
                } else if request.responseHttpStatus == 402 {
                    Console.print(
                        i18nOut(
                            "Please setup your payment profile by visiting this URL:\n"
                            "%s\nPress enter when you're done.\n"
                        ),
                        request.responseBody.buf
                    );
                    Console.getChar();
                } else if request.responseHttpStatus == 400 and request.responseBody == "promotion_code" {
                    def answer: String = getUserMultipleOptionsAnswer(
                        i18nOut(
                            "Provided promotion code is invalid. Re-enter prmotion code? "
                            "(Type `yes` to enter a new code or `cancel` to quit) "
                        ),
                        Map[String, String]()
                            .set(String("yes"), String("yes"))
                            .set(String("y"), String("yes"))
                            .set(String("cancel"), String("cancel"))
                            .set(String("c"), String("cancel"))
                    );
                    if answer == "yes" {
                        promotionCode = getUserTextAnswer(i18nOut(
                            "Enter promotion code or leave empty to proceed without a promotion code: "
                        ), true);
                    } else if answer == "cancel" {
                        System.exit(1);
                    }
                } else if request.responseHttpStatus == 401 {
                    handle401Error[];
                } else {
                    handleUnexpectedCommunicationError[];
                }
            }
        }

        handler this.uploadProject(serverPort: Int, projectPath: String, starter: String) {
            // Generate the tar file.
            def tmpProjectPath: String = String("/tmp/") + this.projectName;
            def tarFilename: String = String("/tmp/") + this.projectName + String(".tar.gz");
            System.exec(String.format("rm -rf \"%s\"", tmpProjectPath.buf));
            if System.exec(String.format("cp -r \"%s\" \"%s\"", projectPath.buf, tmpProjectPath.buf)) != 0 {
                Console.print(i18nOut("Invalid project path.\n"));
                System.exit(1);
            }
            if System.exec(String.format(
                "tar cvzf  \"%s\" -C \"%s\" .",
                tarFilename.buf, tmpProjectPath.buf
            )) != 0 {
                Console.print(i18nOut("Failed to create tar file.\n"));
                System.exit(1);
            }

            def buffer: UnqRef[array[Char, BATCH_SIZE]];
            buffer.construct();
            while 1 {
                def fp: ptr[Fs.File] = Fs.openFile(tarFilename, "rb");
                Fs.seek(fp, 0, Fs.Seek.END);
                def totalSize: ArchInt = Fs.tell(fp);
                Fs.seek(fp, 0, Fs.Seek.SET);
                def startOffset: ArchInt = 0;
                while startOffset < totalSize {
                    Console.print(i18nOut("Uploading: %d%%"), (startOffset * 100 / totalSize)~cast[Int]);
                    Console.print("\r");
                    Fs.flush(0~cast[ptr[Fs.File]]);
                    def batchSize: ArchInt = Fs.read(buffer, 1, BATCH_SIZE, fp);
                    if batchSize == 0 {
                        Console.print(i18nOut("Unexpected error. Try re-starting the deployment.\n"));
                        System.exit(1);
                    }
                    def request: Net.Request(String.format(
                        "%s%s?project=%s&port=%i&start=%s", host.buf, UPLOAD_PROJECT_PATH,
                        Net.uriEncode(this.projectName).buf, serverPort,
                        Net.uriEncode(starter).buf
                    ));
                    request.verbose = this.verbose;
                    request.authKey = this.apiKey;
                    request.authType = "Bearer";
                    request.contentType = "application/octet-stream";
                    request.addHeader(String.format("Content-Total-Length: %i", totalSize~cast[Int]));
                    request.addHeader(String.format("Content-Start-Offset: %i", startOffset~cast[Int]));
                    request.put(buffer, batchSize);
                    if request.responseHttpStatus == 200 {
                        startOffset += batchSize;
                    } else if request.responseHttpStatus == 400 {
                        Console.print(i18nOut("Upload failed. File is too big!\n"));
                        System.exit(1);
                    } else if request.responseHttpStatus == 404 {
                        Console.print(i18nOut("Unexpected error. Try re-starting the deployment.\n"));
                        System.exit(1);
                    } else if request.responseHttpStatus == 423 {
                        Console.print(i18nOut(
                            "Some operation is currently in progress on this project's container. Retry (yes/no)? "
                        ));
                        if getUserYesNoAnswer(String()) != "yes" {
                            System.exit(1);
                        }
                        continue 2;
                    } else if request.responseHttpStatus == 401 {
                        handle401Error[];
                        continue 2;
                    } else {
                        handleUnexpectedCommunicationError[];
                        continue 2;
                    }
                }
                Console.print(i18nOut("Uploading: %d%%"), 100);
                Console.print("\n");
                break;
            }
            System.exec(String.format("rm -rf \"%s\"", tmpProjectPath.buf));
            Fs.remove(tarFilename);
            Console.print(i18nOut("Deployment successful.\n"));
        }

        handler this.uploadBackup(filePath: String) {
            def buffer: UnqRef[array[Char, BATCH_SIZE]];
            buffer.construct();
            while 1 {
                def fp: ptr[Fs.File] = Fs.openFile(filePath, "rb");
                Fs.seek(fp, 0, Fs.Seek.END);
                def totalSize: ArchInt = Fs.tell(fp);
                Fs.seek(fp, 0, Fs.Seek.SET);
                def startOffset: ArchInt = 0;
                while startOffset < totalSize {
                    Console.print(i18nOut("Uploading: %d%%"), (startOffset * 100 / totalSize)~cast[Int]);
                    Console.print("\r");
                    Fs.flush(0~cast[ptr[Fs.File]]);
                    def batchSize: ArchInt = Fs.read(buffer, 1, BATCH_SIZE, fp);
                    if batchSize == 0 {
                        Console.print(i18nOut("Unexpected error. Try re-uploading backup.\n"));
                        System.exit(1);
                    }
                    def request: Net.Request(String.format(
                        "%s%s?project=%s", host.buf, UPLOAD_BACKUP_PATH,
                        Net.uriEncode(this.projectName).buf
                    ));
                    request.verbose = this.verbose;
                    request.authKey = this.apiKey;
                    request.authType = "Bearer";
                    request.contentType = "application/octet-stream";
                    request.addHeader(String.format("Content-Total-Length: %i", totalSize~cast[Int]));
                    request.addHeader(String.format("Content-Start-Offset: %i", startOffset~cast[Int]));
                    request.put(buffer, batchSize);
                    if request.responseHttpStatus == 200 {
                        startOffset += batchSize;
                    } else if request.responseHttpStatus == 400 {
                        Console.print(i18nOut("Upload failed. File is too big!\n"));
                        System.exit(1);
                    } else if request.responseHttpStatus == 404 {
                        Console.print(i18nOut("Unexpected error. Try re-uploading the database.\n"));
                        System.exit(1);
                    } else if request.responseHttpStatus == 401 {
                        handle401Error[];
                        continue 2;
                    } else {
                        handleUnexpectedCommunicationError[];
                        continue 2;
                    }
                }
                Console.print(i18nOut("Uploading: %d%%"), 100);
                Console.print("\n");
                break;
            }
            Console.print(i18nOut("Database restored successfully.\n"));
        }

        handler this.downloadBackup(filePath: String) {
            def downloadUrl: String = this.createBackup();
            if downloadUrl != String("") {
                while 1 {
                    if Net.get(downloadUrl.buf, filePath.buf) == false {
                        handleUnexpectedCommunicationError[];
                    } else {
                        break;
                    }
                }
                Console.print(i18nOut("Database backup downloaded successfully.\n"));
            }
        }

        handler this.createBackup(): String {
            def downloadUrl: String = "";
            def backupName: String = "";
            while 1 {
                def request: Net.Request(String.format(
                    "%s%s?project=%s&backup_type=database", host.buf, CREATE_BACKUP_PATH,
                    Net.uriEncode(this.projectName).buf
                ));
                request.verbose = this.verbose;
                request.authType = "Bearer";
                request.authKey = this.apiKey;
                request.contentType = "application/json";
                request.post(String("{}"));
                if request.responseHttpStatus == 200 {
                    downloadUrl = Json(request.responseBody)("downloadUrl");
                    backupName = Json(request.responseBody)("backupName");
                    break;
                } else if request.responseHttpStatus == 401 {
                    handle401Error[];
                } else if request.responseHttpStatus == 404 {
                    Console.print(i18nOut("Project not found\n"));
                    break;
                } else if request.responseHttpStatus == 423 {
                    Console.print(i18nOut(
                        "Some operation is currently in progress on this project's container. Retry (yes/no)? "
                    ));
                    if getUserYesNoAnswer(String()) != "yes" {
                        System.exit(1);
                    }
                } else {
                    handleUnexpectedCommunicationError[];
                }
            }
            if this.isBackupReady(backupName) return downloadUrl;

            return String("");
        }

        handler this.isBackupReady(backupName: String): bool {
            while 1 {
                def request: Net.Request(String.format(
                    "%s%s?project=%s&backup=%s", host.buf, CHECK_BACKUP_STATUS,
                    Net.uriEncode(this.projectName).buf,
                    Net.uriEncode(backupName).buf
                ));
                request.verbose = this.verbose;
                request.authType = "Bearer";
                request.authKey = this.apiKey;
                request.contentType = "application/json";
                request.get();
                if request.responseHttpStatus == 200 {
                    def status: String = "";
                    status = Json(request.responseBody)("status");
                    if status == String("creating") {
                        Console.print(i18nOut("Backup is not created yet!\n"));
                        // for 5 sec
                        System.sleep(5000000);
                        Console.print(i18nOut("Waiting!\n"));
                    } else if status == String("creating_failed") {
                        Console.print(i18nOut("Backup creation field\n"));
                        break;
                    } else return true;
                } else if request.responseHttpStatus == 401 {
                    handle401Error[];
                } else if request.responseHttpStatus == 404 {
                    Console.print(i18nOut("Project or project backup not found\n"));
                    break;
                } else {
                    handleUnexpectedCommunicationError[];
                }
            }
            return false;
        }

        handler this.selectPlan(): String {
            def i: Int;
            def options: Map[String, String];
            for i = 0, i < this.plans.getLength(), ++i {
                Console.print(
                    "\n%s%d%s: %s",
                    Console.Style.FG_GREEN, i + 1, Console.Style.RESET,
                    getPlanInfoString(this.plans(i)).buf
                );
                def num: String = String() + (i + 1);
                options.set(num, num);
            }
            Console.print("\n");
            Console.print(i18nOut("Enter the selected plan's number:\n"));
            def answer: String = getUserMultipleOptionsAnswer(String(), options);
            return this.plans(String.parseInt(answer) - 1)("id");
        }

        func getPlanInfoString(plan: Json): String {
            return String.format(
                i18nOut(
                    "%s - %s\n"
                    "Monthly cost: $%s USD\n"
                    "Memory: %i MB\n"
                    "CPU: %i cores (%s allowance)\n"
                    "Network egress: %i MB\n"
                    "Network ingress: %i MB\n"
                    "Disk read: %i MB/s\n"
                    "Disk write: %i MB/s\n"
                    "Disk space: %i GB\n"
                ),
                getLocalizedText(plan("nameLocalizations"), plan("name")).buf,
                getLocalizedText(plan("descriptionLocalizations"), plan("description")).buf,
                formatPrice(plan("price")).buf,
                plan("memoryLimitMb")~cast[Int],
                plan("cpuLimit")~cast[Int],
                plan("cpuAllowanceLimit")~cast[String].buf,
                plan("networkEgressLimitMb")~cast[Int],
                plan("networkIngressLimitMb")~cast[Int],
                plan("diskReadLimitMb")~cast[Int],
                plan("diskWriteLimitMb")~cast[Int],
                plan("diskSpaceLimitGb")~cast[Int]
            );
        }

        // Localizations are formatted as one "<langCode>:<text>" entry per line.
        func getLocalizedText(localizations: String, defaultText: String): String {
            if localizations.trim() == "" return defaultText;
            def lines: Array[String] = localizations.split("\n");
            def i: Int;
            for i = 0, i < lines.getLength(), ++i {
                def line: String = lines(i).trim();
                if line == "" continue;
                def sepPos: ArchInt = line.find(':');
                if sepPos == -1 continue;
                if line.slice(0, sepPos).trim() == textAssets.currentLanguage {
                    return line.slice(sepPos + 1, line.getLength() - sepPos - 1).trim();
                }
            }
            return String(defaultText);
        }

        func formatPrice(f: Float): String {
            def result: String;
            if f < 0 {
                f *=  - 1;
                result.append('-');
            }
            result.append(f~cast[Int[64]]);
            def fractions: Float[64] = f - f~cast[Int[64]];
            result.append('.');
            result._append((fractions * 100.0f64 + 0.5f64)~cast[Int[64]], 2);
            return result;
        }

        func checkProjectName(projectName: String): Bool {
            def matcher: Regex.Matcher("^[a-z0-9\\-]+$");
            return matcher.match(projectName.buf).getLength() > 0;
        }
    }
}
